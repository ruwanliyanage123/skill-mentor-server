class Solution {
    public int solution(int[] A) {
        int N = A.length;
        boolean[] seen = new boolean[N + 1]; // index 0 to N

        for (int num : A) {
            if (num > 0 && num <= N) {
                seen[num] = true;
            }
        }

        for (int i = 1; i <= N; i++) {
            if (!seen[i]) {
                return i; // the first missing positive number
            }
        }

        return N + 1; // all 1..N are present
    }
}
