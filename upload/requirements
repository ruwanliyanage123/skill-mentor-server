public int solution(int N) {
    String binary = Integer.toBinaryString(N);
    int maxGap = 0;
    int currentGap = -1;

    for (char c : binary.toCharArray()) {
        if (c == '1') {
            if (currentGap > maxGap) {
                maxGap = currentGap;
            }
            currentGap = 0; // start counting for next potential gap
        } else if (currentGap >= 0) {
            currentGap++; // count zeros only after a '1'
        }
    }
    return maxGap;
}


