Q)
A binary gap within a positive integer N is any maximal sequence of consecutive zeros that is surrounded by ones at both ends in the binary representation of N.

For example, number 9 has binary representation 1001 and contains a binary gap of length 2. The number 529 has binary representation 1000010001 and contains two binary gaps: one of length 4 and one of length 3. The number 20 has binary representation 10100 and contains one binary gap of length 1. The number 15 has binary representation 1111 and has no binary gaps. The number 32 has binary representation 100000 and has no binary gaps.


My answer


class Solution {
    private final StringBuilder builder = new StringBuilder();

    public int solution(int N) {
        convertBinaryString(N);
        int result = countMaximumConsecutiveZeros(builder.reverse().toString());
        return result;
    }

    public int convertBinaryString(int N){
        if(N == 1){
            builder.append(1);
            return 1;
        }
        int remain = N % 2;
        builder.append(remain);
        return convertBinaryString(N/2);
    }

    private int countMaximumConsecutiveZeros(String number){
        int maximuCount = 0;
        int inprogressCount = 0;
        boolean countStarted = false;
        boolean zeroFound = false;
        for(int i=0; i<number.length(); i++){
            if(number.charAt(i) == '1' && inprogressCount==0){
                countStarted = true;
                continue;
            }
            if(number.charAt(i) == '0' && countStarted){
                inprogressCount ++;
                zeroFound = true;
            }
            if(number.charAt(i) == '1' && inprogressCount>0 && zeroFound){
                countStarted = false;
                zeroFound = false;
                if(maximuCount < inprogressCount){
                    maximuCount = inprogressCount;
                }
                inprogressCount = 0;
            }

        }
        return maximuCount;
    }
}


